---
description: Footer group divider vs table end line
strip:
  - -webkit-*
  - -moz-*
  - animation-*
  - transition-*
  - font-family
---

# The table's bottom end line (tfoot border-bottom)
.rpg-table-tfoot

# The internal group divider we want to match it
.rpg-table-tfoot__divider td

# The footer cell row (body→footer boundary line)
.rpg-table-tfoot__cell-row td

# A body cell, to see the theme's structural border color
.rpg-table tbody tr:last-child td
